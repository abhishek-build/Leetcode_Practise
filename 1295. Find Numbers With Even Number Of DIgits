class Solution{
public:
    int findNumbers(vector<int>& nums){
        int evenCount = 0;

        for(int num : nums){
            int digits = 0;
            int temp = num;

            while(temp>0){
                temp/=10;
                digits++;
            }
            if(digits % 2 == 0){
                evenCount++;
            }
        }
        return evenCount; 
    }
};
