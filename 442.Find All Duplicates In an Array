class Solution{
public:
    vector<int> findDuplicates(vector<int>& nums){
       vector<int> result;
       for(int i = 0; i<nums.size();i++){
        int val=abs(nums[i]);
        int index=val-1;
        if(nums[index]<0){
            result.push_back(val);
        }
        else{
            nums[index]=-nums[index];
        }
       }
       return result;
    }
};
